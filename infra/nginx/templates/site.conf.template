map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

limit_req_status 429;
limit_req_zone $binary_remote_addr zone=api_per_ip:20m rate=120r/m;
limit_req_zone $binary_remote_addr zone=auth_login_per_ip:10m rate=5r/m;

resolver 127.0.0.11 valid=10s ipv6=off;

upstream backend {
    zone backend_zone 64k;
    server ${ACTIVE_BACKEND_SLOT}:8080 resolve;
}

upstream minio_api { server minio:9000 resolve; zone minio_api_zone 64k; }
upstream minio_panel { server minio:9001 resolve; zone minio_panel_zone 64k; }
upstream databasus { server databasus:4005 resolve; zone databasus_zone 64k; }

server {
    listen 8080;
    server_name ${APP_DOMAIN};

    location = /nginx-healthz {
        access_log off;
        default_type text/plain;
        return 200 "";
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
   listen 8080;
   server_name s3.${APP_DOMAIN};

   location /.well-known/acme-challenge/ {
       root /var/www/certbot;
   }

   location = /knowledge-private {
       return 404;
   }

   location ^~ /knowledge-private/ {
       return 404;
   }

   location / {
       return 301 https://$host$request_uri;
   }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};

    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: ${MINIO_PUBLIC_URL}; font-src 'self' data:; style-src 'self' 'nonce-$request_id'; script-src 'self' 'nonce-$request_id'; script-src-attr 'none'; connect-src 'self' ${MINIO_PUBLIC_URL}; upgrade-insecure-requests" always;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_set_header X-CSP-Nonce       $request_id;
    proxy_read_timeout 300;
    proxy_send_timeout 300;

    location ^~ /api/docs {
        limit_req zone=api_per_ip burst=120 nodelay;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: ${MINIO_PUBLIC_URL} https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self' ${MINIO_PUBLIC_URL}; upgrade-insecure-requests" always;
        proxy_pass http://backend;
    }

    location = /api/auth/login {
        limit_req zone=auth_login_per_ip burst=5 nodelay;
        limit_req zone=api_per_ip burst=60 nodelay;
        proxy_pass http://backend;
    }

    location /api/ {
        limit_req zone=api_per_ip burst=120 nodelay;
        proxy_pass http://backend/api/;
    }

    location / {
        return 404;
    }
}

server {
    listen 18081;
    server_name _;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_read_timeout 300;
    proxy_send_timeout 300;

    location / {
        proxy_pass http://minio_panel;
    }
}

server {
    listen 18082;
    server_name _;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_read_timeout 300;
    proxy_send_timeout 300;

    location / {
        proxy_pass http://databasus;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name s3.${APP_DOMAIN};

    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};

    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;

    proxy_read_timeout 300;
    proxy_send_timeout 300;

    location = /knowledge-private {
        return 404;
    }

    location ^~ /knowledge-private/ {
        return 404;
    }

    location / {
        proxy_pass http://minio_api;
    }
}
